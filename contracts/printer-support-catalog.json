      "diagnostics": ["verify_user_and_device", "inspect_mapping", "compare_authorized_group_without_expansion", "request_server_permission_evidence", "check_policy_application"],
      "hypotheses": ["missing_entitlement", "stale_mapping", "policy_not_applied", "server_permission_failure"],
