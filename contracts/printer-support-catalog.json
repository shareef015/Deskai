        {"action": "restart_spooler_after_queue_assessment", "risk": "medium", "approval": "user_or_engineer", "rollback": "restore_service_state"},
        {"action": "clear_spool_files_after_job_owner_review", "risk": "medium", "approval": "engineer", "rollback": "jobs_require_resubmission"},
        {"action": "remove_or_replace_faulting_driver", "risk": "high", "approval": "privileged_engineer", "rollback": "restore_signed_driver_package"}
      ],
      "verification": ["spooler_running_stably", "printer_inventory_restored", "test_job_completes", "physical_output_confirmed", "employee_confirms"]
    },
    {
      "id": "PRINT-PORT-001",
      "name": "incorrect_or_unreachable_printer_port",
      "signals": ["tcp_port_timeout", "stale_ip", "wrong_hostname", "wsd_instability", "ipp_failure"],
      "questions": ["What printer asset label or hostname is expected?", "Was its address recently changed?", "Can another approved device reach it?"],
      "diagnostics": ["inspect_port_configuration", "resolve_hostname", "test_ip_reachability", "test_protocol_port", "compare_asset_inventory", "detect_duplicate_ip"],
      "hypotheses": ["stale_ip_address", "dns_failure", "wrong_port_protocol", "network_acl", "duplicate_ip", "wsd_discovery_failure"],
      "remediations": [
        {"action": "update_approved_tcp_ip_port", "risk": "medium", "approval": "engineer", "rollback": "restore_previous_port"},
        {"action": "recreate_approved_ipp_or_wsd_mapping", "risk": "medium", "approval": "engineer", "rollback": "restore_previous_mapping"},
        {"action": "change_network_acl_or_dns", "risk": "high", "approval": "network_administrator", "rollback": "restore_network_configuration"}
