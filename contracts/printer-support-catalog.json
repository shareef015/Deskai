      "verification": ["protocol_port_reachable", "printer_ready_state", "test_job_completes", "physical_output_confirmed", "employee_confirms"]
    },
    {
      "id": "PRINT-SERVER-001",
      "name": "shared_printer_or_print_server_failure",
      "signals": ["share_unavailable", "server_name_unresolved", "access_denied", "multiple_users_affected"],
      "questions": ["Are multiple users affected?", "Can you reach the approved print server?", "Was access or the queue recently changed?"],
      "diagnostics": ["resolve_print_server", "test_server_connectivity", "inspect_client_mapping", "check_multiple_user_impact", "request_server_queue_evidence", "request_permission_evidence"],
      "hypotheses": ["server_outage", "name_resolution_failure", "share_removed", "permission_failure", "server_queue_or_spooler_failure"],
      "remediations": [
        {"action": "reconnect_verified_print_share", "risk": "medium", "approval": "user_or_engineer", "rollback": "restore_previous_mapping"},
        {"action": "restart_server_spooler_or_modify_share", "risk": "high", "approval": "print_server_administrator", "rollback": "administrator_defined"},
        {"action": "change_print_permission", "risk": "high", "approval": "print_server_administrator", "rollback": "restore_permission_snapshot"}
      ],
      "verification": ["share_accessible", "client_mapping_healthy", "test_job_completes", "physical_output_confirmed", "employee_confirms"]
    },
    {
      "id": "PRINT-DRIVER-001",
      "name": "driver_missing_incompatible_or_crashing",
      "signals": ["driver_unavailable", "driver_install_failure", "spooler_crash_module", "incorrect_output", "architecture_mismatch"],
      "questions": ["What is the exact printer model?", "Did this begin after a Windows or driver update?", "Is Windows Protected Print Mode enabled?"],
      "diagnostics": ["inventory_driver", "verify_driver_signature", "compare_device_model", "inspect_architecture", "inspect_protected_print_mode", "collect_spooler_crash_evidence"],
      "hypotheses": ["unsigned_or_incompatible_driver", "wrong_model_driver", "protected_print_incompatibility", "driver_regression", "damaged_driver_package"],
      "remediations": [
        {"action": "switch_to_approved_windows_ready_print", "risk": "high", "approval": "privileged_engineer", "rollback": "restore_previous_signed_driver"},
        {"action": "install_approved_signed_oem_driver", "risk": "high", "approval": "privileged_engineer", "rollback": "restore_previous_signed_driver"}
      ],
      "verification": ["driver_loaded_without_error", "spooler_stable", "test_job_completes", "output_rendering_correct", "physical_output_confirmed", "employee_confirms"]
    },
    {
      "id": "PRINT-PROTECTED-001",
      "name": "windows_protected_print_mode_incompatibility",
      "signals": ["third_party_printer_removed", "driver_install_blocked", "mopria_incompatibility", "policy_managed_setting"],
      "questions": ["Was Windows Protected Print Mode recently enabled?", "Is the printer Mopria certified?", "Is the setting controlled by company policy?"],
      "diagnostics": ["inspect_protected_print_mode", "inspect_policy_source", "check_mopria_compatibility", "inventory_removed_or_incompatible_queues", "inspect_windows_ready_print"],
      "hypotheses": ["third_party_driver_removed_by_design", "non_mopria_device", "policy_enforcement", "unsupported_device_workflow"],
      "remediations": [
        {"action": "reinstall_compatible_printer_with_windows_ready_print", "risk": "medium", "approval": "engineer", "rollback": "remove_added_mapping"},
        {"action": "change_protected_print_policy", "risk": "high", "approval": "endpoint_security_administrator", "rollback": "restore_policy_snapshot"}
      ],
      "verification": ["security_policy_remains_compliant", "compatible_queue_present", "test_job_completes", "physical_output_confirmed", "employee_confirms"]
