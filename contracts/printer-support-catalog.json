      "signals": ["spooler_stopped", "spoolsv_crash", "printers_disappear", "all_local_queues_fail"],
      "questions": ["Do all printers disappear or only one?", "Did this begin after a driver installation?", "Are pending jobs business-critical?"],
      "diagnostics": ["inspect_spooler_state", "collect_service_events", "collect_printservice_events", "inventory_pending_jobs", "inventory_recent_driver_changes", "check_resource_pressure"],
