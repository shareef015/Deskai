      "questions": ["Which job is stuck and who owns it?", "Are other jobs or users affected?", "Does the document contain sensitive information?"],
      "diagnostics": ["enumerate_jobs_metadata_only", "identify_job_owner", "inspect_job_status", "inspect_spooler", "inspect_printservice_events"],
      "hypotheses": ["corrupt_job", "application_rendering_failure", "spooler_deadlock", "driver_failure", "device_unreachable"],
