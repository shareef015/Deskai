{
  "schema_version": "1.0.0",
  "platform": "windows_10_and_11",
  "protocols": ["usb", "tcp_9100", "ipp", "ipps", "wsd", "smb_print_share"],
  "evidence_order": [
    "employee_physical_observation",
    "windows_printer_inventory",
    "queue_and_job_state",
    "spooler_and_printservice_events",
    "port_and_network_reachability",
    "print_server_state",
    "driver_and_protection_mode_compatibility",
    "version_matched_knowledge"
  ],
  "risk_levels": {
    "read_only": "no_endpoint_change",
    "low": "reversible_queue_or_session_change",
    "medium": "persistent_printer_mapping_port_or_spooler_change",
    "high": "driver_security_policy_server_or_privileged_change"
  },
  "incidents": [
    {
      "id": "PRINT-POWER-001",
      "name": "physical_power_or_device_error",
      "signals": ["no_display", "device_error_light", "paper_jam", "cover_open", "low_toner_or_ink"],
      "questions": ["Is the printer powered on?", "What is displayed on the printer panel?", "Are paper, toner, ink and covers in normal condition?"],
      "diagnostics": ["request_physical_observation", "inspect_windows_status_read_only", "check_other_users"],
      "hypotheses": ["no_power", "paper_jam", "consumable_empty", "cover_open", "mechanical_failure"],
      "remediations": [{"action": "guided_physical_check", "risk": "read_only", "approval": "user", "rollback": "not_required"}],
      "verification": ["device_ready_observed", "test_page_submitted", "physical_output_confirmed", "employee_confirms"],
      "escalation": ["electrical_hazard", "mechanical_failure", "consumable_or_parts_required"]
    },
    {
      "id": "PRINT-DISCOVERY-001",
      "name": "printer_not_found_or_not_recognized",
      "signals": ["missing_from_inventory", "usb_not_recognized", "discovery_timeout", "device_setup_failed"],
      "questions": ["Is the printer connected by USB, network or print server?", "Can another employee discover it?", "Was the printer or network recently changed?"],
      "diagnostics": ["enumerate_printers", "inspect_plug_and_play", "check_usb_or_network_link", "check_spooler", "test_discovery_protocol", "inspect_protected_print_mode"],
      "hypotheses": ["physical_link_failure", "spooler_failure", "discovery_protocol_failure", "driver_or_policy_incompatibility", "wrong_network"],
      "remediations": [
        {"action": "restart_spooler_after_queue_assessment", "risk": "medium", "approval": "user_or_engineer", "rollback": "restore_service_state"},
        {"action": "add_approved_printer", "risk": "medium", "approval": "user_or_engineer", "rollback": "remove_added_mapping"},
        {"action": "change_protected_print_policy", "risk": "high", "approval": "endpoint_security_administrator", "rollback": "restore_policy_snapshot"}
      ],
      "verification": ["printer_inventory_contains_target", "printer_ready_state", "test_page_submitted", "physical_output_confirmed", "employee_confirms"]
    },
    {
      "id": "PRINT-OFFLINE-001",
      "name": "printer_offline",
      "signals": ["offline", "paused", "use_printer_offline_enabled", "unreachable_port"],
      "questions": ["Is the printer panel showing Ready?", "Can another employee print?", "Is this a local or shared printer?"],
      "diagnostics": ["inspect_printer_state", "inspect_queue_flags", "inspect_port", "test_dns_and_ip", "test_protocol_port", "check_print_server_if_shared"],
      "hypotheses": ["offline_flag", "paused_queue", "stale_ip_address", "network_failure", "print_server_failure", "physical_device_offline"],
      "remediations": [
        {"action": "resume_printer_queue", "risk": "low", "approval": "user", "rollback": "pause_queue"},
        {"action": "disable_use_printer_offline", "risk": "low", "approval": "user", "rollback": "restore_previous_flag"},
        {"action": "update_approved_tcp_ip_port", "risk": "medium", "approval": "engineer", "rollback": "restore_previous_port"}
      ],
      "verification": ["online_or_ready_state", "test_page_submitted", "job_leaves_queue", "physical_output_confirmed", "employee_confirms"]
    },
    {
      "id": "PRINT-QUEUE-001",
      "name": "stuck_or_failed_print_job",
