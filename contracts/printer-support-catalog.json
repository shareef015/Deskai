    {
      "id": "PRINT-PERF-001",
      "name": "slow_printing_or_incorrect_output",
      "signals": ["slow_spooling", "slow_device_output", "garbled_output", "wrong_orientation", "poor_quality"],
      "questions": ["Is every document affected or one application/file?", "Does a Windows test page print correctly?", "Are the paper, quality and finishing settings correct?"],
      "diagnostics": ["submit_controlled_test_page", "compare_simple_and_complex_job", "inspect_preferences", "inspect_driver", "measure_network_latency", "request_physical_output_observation"],
      "hypotheses": ["application_rendering", "job_complexity", "quality_setting", "driver_mismatch", "network_latency", "physical_consumable_or_hardware_issue"],
      "remediations": [
        {"action": "correct_user_approved_print_preferences", "risk": "low", "approval": "user", "rollback": "restore_preferences_snapshot"},
        {"action": "switch_to_approved_driver", "risk": "high", "approval": "privileged_engineer", "rollback": "restore_previous_signed_driver"}
      ],
      "verification": ["test_page_latency_within_policy", "output_rendering_correct", "physical_output_confirmed", "physical_quality_confirmed", "employee_confirms"]
