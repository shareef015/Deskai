{
  "schema_version": "1.0.0",
  "single_root": "deskpilot-ai",
  "deployables": {
    "web": "apps/web",
    "api": "services/api",
    "ai_service": "services/ai-service",
    "rag_service": "services/rag-service",
    "mcp_gateway": "services/mcp-gateway",
    "worker": "services/worker"
  },
  "shared_packages": ["packages/python", "packages/typescript"],
  "operational_roots": ["config", "data/synthetic", "infra"],
  "rules": [
    "deployables_must_not_import_another_deployable",
    "cross_service_contracts_live_in_packages_or_contracts",
    "secrets_must_not_be_committed",
    "endpoint_execution_is_available_only_through_mcp_gateway"
  ]
}
