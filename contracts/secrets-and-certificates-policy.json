{
  "schema_version": "1.0.0",
  "authority": "deterministic_secret_control_plane",
  "approved_providers": ["env", "file", "vault"],
  "protected_secret_classes": [
    "database_credentials",
    "redis_credentials",
    "oidc_client_credentials",
    "service_account_credentials",
    "model_provider_api_keys",
    "langsmith_api_keys",
    "endpoint_ca_private_keys",
    "mcp_service_credentials"
  ],
  "invariants": {
    "plaintext_in_repository": false,
    "plaintext_in_logs_traces_errors_or_audit": false,
    "plaintext_in_configuration_fingerprint": false,
    "llm_secret_access": false,
    "private_key_export": false,
    "startup_with_missing_required_secret": false,
    "startup_with_expired_certificate": false,
    "provider_access_is_least_privilege": true,
    "rotation_is_audited": true
  },
  "rotation": {
    "metadata_required": ["secret_id", "version", "rotated_at", "expires_at"],
    "expiry_warning_days": 14,
    "overlap_required_for_zero_downtime": true,
    "events": ["secret_rotation_started", "secret_version_activated", "secret_rotation_completed", "secret_rotation_failed"]
  },
  "certificates": {
    "endpoint_transport": "mutual_tls",
    "private_keys": "non_exportable_or_secret_provider_reference",
    "revocation_required": true,
    "renewal_before_expiry_required": true,
    "hostname_and_trust_chain_validation": true
  },
  "required_runtime_references": [
    "database_url_ref",
    "redis_url_ref",
    "endpoint_ca_certificate_ref"
  ]
}
