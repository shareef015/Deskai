{
  "schema_version": "1.0.0",
  "platform": "windows_10_and_11",
  "purpose": "support_outlook_printer_scanner_and_endpoint_connectivity",
  "evidence_order": [
    "employee_scope_and_last_known_good",
    "windows_build_and_update_state",
    "adapter_link_and_driver_state",
    "ip_dhcp_gateway_and_route_state",
    "dns_resolution",
    "proxy_vpn_and_policy_state",
    "target_specific_port_and_application_test",
    "event_logs_and_resource_state"
  ],
  "sensitive_evidence_rules": [
    "never_collect_wifi_keys",
    "never_collect_vpn_secrets",
    "never_export_private_certificate_keys",
    "redact_usernames_public_ips_and_internal_hostnames_by_policy",
    "collect_event_windows_not_unbounded_logs"
  ],
  "risk_levels": {
    "read_only": "no_endpoint_change",
    "low": "reversible_cache_or_connection_refresh",
    "medium": "persistent_adapter_service_or_user_network_change",
    "high": "network_reset_driver_firewall_vpn_proxy_dns_or_enterprise_policy_change"
  },
  "incidents": [
    {
      "id": "WIN-NET-ADAPTER-001",
      "name": "network_adapter_disabled_missing_or_error",
      "signals": ["adapter_disabled", "adapter_missing", "device_problem_code", "driver_load_error", "no_link"],
      "questions": ["Are you using Wi-Fi, Ethernet or both?", "Did this begin after an update, dock change or restart?", "Is Airplane mode enabled?"],
      "diagnostics": ["enumerate_adapters", "inspect_link_state", "inspect_device_problem_code", "inspect_driver_version", "inspect_airplane_mode", "collect_network_events"],
      "hypotheses": ["adapter_disabled", "physical_link_failure", "driver_failure", "dock_or_usb_failure", "airplane_mode", "hardware_failure"],
      "remediations": [
        {"action": "enable_approved_adapter", "risk": "medium", "approval": "user_or_engineer", "rollback": "restore_adapter_state"},
        {"action": "disable_enable_approved_adapter", "risk": "medium", "approval": "user_or_engineer", "rollback": "restore_adapter_state"},
        {"action": "install_approved_signed_adapter_driver", "risk": "high", "approval": "privileged_engineer", "rollback": "restore_previous_signed_driver"}
      ],
      "verification": ["adapter_enabled", "valid_link_state", "target_business_function_works", "employee_confirms"]
    },
    {
      "id": "WIN-NET-WIFI-001",
      "name": "wifi_disconnected_unstable_or_wrong_network",
      "signals": ["wifi_disconnected", "frequent_disconnect", "weak_signal", "wrong_ssid", "authentication_failure"],
      "questions": ["Which approved network should you be connected to?", "Are nearby employees affected?", "Does the issue change by location?"],
      "diagnostics": ["inspect_wifi_state", "inspect_ssid_without_key", "inspect_signal_quality", "collect_wlan_disconnect_reasons", "inspect_driver", "compare_site_impact"],
      "hypotheses": ["wrong_network", "weak_signal_or_interference", "authentication_or_certificate_failure", "driver_failure", "access_point_or_site_outage"],
      "remediations": [
        {"action": "connect_to_approved_existing_wifi_profile", "risk": "low", "approval": "user", "rollback": "disconnect_profile"},
        {"action": "reconnect_approved_wifi_profile", "risk": "low", "approval": "user", "rollback": "restore_previous_connection"},
        {"action": "delete_or_reprovision_managed_wifi_profile", "risk": "high", "approval": "network_or_endpoint_administrator", "rollback": "restore_managed_profile"}
