      "questions": ["Does the service work by approved IP but not hostname?", "Are internal, external or both names affected?", "Does the failure occur only on VPN?"],
      "diagnostics": ["inspect_dns_servers", "resolve_approved_test_names", "compare_name_and_ip_connectivity", "inspect_dns_cache_metadata", "inspect_nrpt_and_vpn_context", "collect_dns_client_events"],
