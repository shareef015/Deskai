      "signals": ["media_disconnected", "link_flap", "limited_connectivity", "dock_adapter_missing"],
      "questions": ["Is Ethernet connected directly or through a dock?", "Are link lights visible?", "Does a known-good approved cable or port work?"],
      "diagnostics": ["inspect_ethernet_link", "inspect_speed_and_duplex_read_only", "inspect_dock_or_usb_adapter", "collect_link_events", "compare_switch_port_evidence_if_available"],
