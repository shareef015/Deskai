{
  "name": "deskpilot-ai-frontend-e2e",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "build": "next build",
    "test:reliability": "jest --runInBand tests/reliability tests/performance",
    "test:quality": "npm run typecheck && npm run lint && npm test && npm run test:reliability",
    "start": "next start",
    "test:security": "jest --runInBand tests/security",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "security:ci": "npm run typecheck && npm run lint && npm run test:security && npm run test:identity && npm run build && npm run security:deps",
    "test:identity": "jest --runInBand tests/security/identity-boundary.test.ts tests/security/identity-csrf.test.ts",
    "test:demo": "playwright test tests/e2e/recruiter-demo.spec.ts",
    "test:final": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:demo"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "jest": "30.4.2",
    "jest-axe": "11.0.0",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  }
}
